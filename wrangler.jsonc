{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vexora-site",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-20",
  // Keeps the site reachable at vexora-site.<subdomain>.workers.dev.
  // Without this, adding a route disables the workers.dev URL on deploy.
  "workers_dev": true,
  // Enable these only once vexora.site is an active zone in this Cloudflare
  // account (i.e. after the nameservers at the registrar point to Cloudflare).
  // Deploying with them before that fails with: "Can't infer zone from route".
  // "routes": [
  //   { "pattern": "vexora.site", "custom_domain": true },
  //   { "pattern": "www.vexora.site", "custom_domain": true }
  // ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/", "/*.html"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vexora-auth",
      "database_id": "fea8eb45-6a9b-4f3a-8678-ac4358aa753e",
      "migrations_dir": "migrations"
    }
  ]
}
