{
  "name": "vexora-site",
  "version": "1.0.0",
  "private": true,
  "description": "Vexora games and creator community website",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node serve.js",
    "test": "node --test",
    "cf:dev": "wrangler dev",
    "cf:db:create": "wrangler d1 create vexora-auth",
    "cf:db:migrate:local": "wrangler d1 migrations apply vexora-auth --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply vexora-auth --remote",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "wrangler": "^4.151.2"
  }
}
